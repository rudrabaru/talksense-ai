# ── Database ──────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/talksense

# ── JWT Auth ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Hugging Face (Pyannote speaker diarization) ───────────
# Create at: https://huggingface.co/settings/tokens
# Accept model license at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_huggingface_token_here

# ── Whisper Model Config ──────────────────────────────────
# Options: tiny, base, small, medium, large-v3
# For GPU with 4GB VRAM: use "small" with int8
# For GPU with 8GB+ VRAM: use "medium" with float16
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cuda

# ── Pyannote Config ───────────────────────────────────────
PYANNOTE_ENABLED=true
PYANNOTE_DEVICE=cuda

# ── App Config ────────────────────────────────────────────
ENV=development
CORS_ORIGINS=http://localhost:5173
