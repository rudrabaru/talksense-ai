# ── Database ──────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Standard local PostgreSQL development default
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talksense

# ── JWT Auth ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be set to a secure random string in production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Hugging Face ──────────────────────────────────────────
# Create at: https://huggingface.co/settings/tokens
# Accept model license for Pyannote before using the token
HF_TOKEN=

# ── Gemini (LLM Role Classification) ──────────────────────
GEMINI_API_KEY=

# ── Whisper Model Config ──────────────────────────────────
# Options: tiny, base, small, medium, large-v3
# Leave language empty for auto-detection
# CPU is the default for portability and CI compatibility
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=

# ── Pyannote Config ───────────────────────────────────────
# CPU is the default for portability and CI compatibility
PYANNOTE_ENABLED=true
PYANNOTE_DEVICE=cpu

# ── App Config ────────────────────────────────────────────
ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Enable only when profiling performance
PROFILING_ENABLED=false